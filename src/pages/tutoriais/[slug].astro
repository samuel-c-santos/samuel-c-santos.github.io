---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const tutoriais = await getCollection('tutoriais');
  return tutoriais.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---
<BaseLayout title={`${entry.data.title} | Samuel Santos`} description={entry.data.description}>
  <header class="page-header page-header--detail">
    <div class="container">
      <p class="page-eyebrow">{entry.data.level || 'Tutorial'}</p>
      <h1 class="page-title">{entry.data.title}</h1>
      <p class="page-subtitle">{entry.data.description}</p>
      <div class="detail-meta">
        {(entry.data.tags || []).map((tag) => (
          <span class="badge badge-tag">{tag}</span>
        ))}
        {entry.data.date && (
          <time datetime={entry.data.date.toISOString()}>
            {entry.data.date.toLocaleDateString('pt-BR')}
          </time>
        )}
      </div>
      {entry.data.thumbnail && (
        <img src={entry.data.thumbnail} alt={entry.data.title} class="detail-thumb" />
      )}
    </div>
  </header>

  <article class="tutorial-detail">
    <div class="container">
      {headings && headings.length > 0 && (
        <nav class="toc">
          <h2>Índice</h2>
          <ul>
            {headings.filter((h) => h.depth <= 3).map((h) => (
              <li class={`toc-depth-${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <div class="prose">
        <Content />
      </div>

      <p class="back-link"><a href="/tutoriais">← Voltar para tutoriais</a></p>
    </div>
  </article>

  <style>
    .page-header { padding: 4rem 0 3rem; background: linear-gradient(180deg, var(--aipim-bg-surface) 0%, var(--aipim-bg-canvas) 100%); text-align: center; position: relative; }
    .page-header::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 50% 0%, var(--aipim-color-primary-100, #e4f0ff) 0%, transparent 60%); opacity: 0.4; pointer-events: none; }
    .page-header .container { position: relative; z-index: 1; }
    .page-header--detail .page-title { font-size: 2.25rem; }
    .page-eyebrow { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.16em; opacity: 0.55; margin-bottom: 0.75rem; font-weight: 600; }
    .page-title { font-size: 3rem; margin: 0 0 1rem; font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; }
    .page-subtitle { opacity: 0.7; max-width: 640px; margin: 0 auto 1rem; font-size: 1.05rem; line-height: 1.6; }
    .detail-meta { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; justify-content: center; margin: 1rem 0; }
    .badge { font-size: 0.75rem; padding: 0.25rem 0.6rem; border-radius: 999px; }
    .badge-level { background: var(--aipim-action-primary-bg, #2563eb); color: #fff; }
    .badge-tag { background: var(--aipim-surface-alt, #f3f4f6); }
    .detail-thumb { width: 100%; max-width: 720px; border-radius: 12px; margin: 1.5rem auto 0; display: block; }
    .tutorial-detail { padding: 2rem 0 3rem; }
    .container { max-width: 800px; margin: 0 auto; padding: 0 1rem; }
    .toc { border: 1px solid var(--aipim-border, #e5e7eb); border-radius: 12px; padding: 1rem 1.25rem; margin: 1.5rem 0; background: var(--aipim-surface, #fff); }
    .toc h2 { font-size: 1rem; margin: 0 0 0.5rem; }
    .toc ul { list-style: none; padding: 0; margin: 0; }
    .toc li { margin: 0.25rem 0; }
    .toc-depth-2 { padding-left: 0; }
    .toc-depth-3 { padding-left: 1rem; }
    .toc a { color: inherit; text-decoration: none; }
    .toc a:hover { text-decoration: underline; }
    .prose { line-height: 1.7; }
    .prose :global(h2) { margin-top: 2rem; }
    .prose :global(h3) { margin-top: 1.5rem; }
    .prose :global(pre) { padding: 1rem; border-radius: 8px; overflow-x: auto; }
    .prose :global(code) { font-family: monospace; }
    .back-link { margin-top: 2rem; }
    .back-link a { color: inherit; }
  </style>
</BaseLayout>